# إعدادات تيكتوك
TIKTOK_USERNAME=your_username
TIKTOK_PASSWORD=your_password

# إعدادات الفيديو
VIDEO_CATEGORY=asmr
MAX_VIDEOS_TO_DOWNLOAD=5
