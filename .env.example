# Database Configuration
DATABASE_PATH=airdrops.db

# Update interval in minutes
UPDATE_INTERVAL=30

# Minimum reliability score (0-100)
MIN_RELIABILITY_SCORE=60

# Data Sources
ENABLE_WEB_SCRAPING=true
ENABLE_RSS_FEEDS=true
ENABLE_TWITTER=false

# Telegram Bot Configuration (Optional)
# To enable Telegram notifications:
# 1. Create a bot with @BotFather on Telegram
# 2. Get your bot token
# 3. Get your chat ID (you can use @userinfobot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Twitter/X API Configuration (Optional)
# To enable Twitter monitoring, you need a Twitter Developer account
TWITTER_BEARER_TOKEN=
